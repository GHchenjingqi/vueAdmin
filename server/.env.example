# ==================================
# 后端环境变量模板（复制为 server/.env 后修改）
# ==================================

# 数据库配置
# 开发启动时 bootstrap 会自动 CREATE DATABASE IF NOT EXISTS
# 生产环境需预先建库，DB_USER 应为受限业务账号（仅有目标库的 CRUD 权限，无 CREATE/SUPER）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vue_admin
DB_USER=root
DB_PASSWORD=root

# 服务配置（开发默认 5173，与前端/E2E 一致）
SERVER_PORT=5173

# JWT 密钥（生产环境必须改为强随机字符串）
JWT_SECRET=vue_admin_secret_key_2024

# CORS / CSRF Origin 白名单（逗号分隔）
ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173,https://127.0.0.1:5173,http://127.0.0.1:5173

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 验证码开关（也可在系统设置中配置 captcha_enabled）
CAPTCHA_ENABLED=true

# 上传
UPLOAD_MAX_SIZE=10
UPLOAD_PATH=./server/uploads

# Redis（可选，多实例限流 / 跨副本踢下线）
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# AI 代码注入开关（生产默认关闭，仅平台超管开启）
# AI_INJECTOR_ENABLED=false

# DeepSeek / AI（可选）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com