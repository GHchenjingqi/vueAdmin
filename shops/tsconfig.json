{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "~/*": ["./*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["./shared/**/*", "./tests/**/*", "./.nuxt/nuxt.d.ts", "**/*.vue", "**/*.ts"]
}
